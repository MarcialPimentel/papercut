{
  "name": "papercut",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,green \"npm run dev:server\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "0.160.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "three": "0.160.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
